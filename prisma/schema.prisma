// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Sprint 0 — Data Foundation. Only Migration 000 (Audit Foundation) and
// Migration 001 (School Foundation) are implemented here — see
// docs/database/MIGRATION_PLAN.md § 2 for the full sequence and
// docs/database/PRISMA_IMPLEMENTATION_GUIDE.md for the conventions this
// file follows (naming, relation mode, datasource split).
//
// Once this schema exceeds ~15 models (PRISMA_IMPLEMENTATION_GUIDE.md § 1),
// split into prisma/schema/ by bounded context. Two models doesn't warrant
// that yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URLs are no longer configured here in Prisma 7 — `url`/`directUrl`
// on the datasource block were removed. Migrations read the connection from
// prisma.config.ts (DIRECT_URL, unpooled); the runtime client connects via a
// driver adapter (@prisma/adapter-pg, DATABASE_URL, pooled) constructed in
// src/lib/db.ts. See docs/database/PRISMA_IMPLEMENTATION_GUIDE.md § 2.
datasource db {
  provider = "postgresql"
}

// --- Migration 000: Audit Foundation ---------------------------------------
// Structurally standalone, no FKs out — see docs/database/MIGRATION_PLAN.md § 1
// for why AuditLog is built first, not last. Uses a time-ordered ID (UUIDv7)
// per docs/database/DATABASE_REVIEW.md § 11 — high insert volume, B-tree
// locality matters. Append-only: no updatedAt, no deletedAt (see
// docs/domain/DOMAIN_MODEL.md § 9.1). The REVOKE UPDATE/DELETE grant
// enforcement from docs/database/AUDIT_STRATEGY.md § 2 requires a real
// Postgres role name this environment doesn't have yet — see this sprint's
// "Manual Actions Required" note, not applied in this migration.
// Partitioning (AUDIT_STRATEGY.md § 3) deliberately deferred: created
// unpartitioned, with no composite primary key or unique constraint that
// would block converting it to a partitioned table later.

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE

  @@map("audit_action")
}

model AuditLog {
  id          String      @id @default(uuid(7))
  schoolId    String      @map("school_id")
  entityType  String      @map("entity_type")
  entityId    String      @map("entity_id")
  actorUserId String      @map("actor_user_id")
  action      AuditAction
  beforeValue Json?       @map("before_value")
  afterValue  Json?       @map("after_value")
  timestamp   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId, timestamp])
  @@index([schoolId, timestamp])
  @@map("audit_logs")
}

// --- Migration 001: School Foundation ---------------------------------------
// The schoolId root every later migration hangs off — see
// docs/database/MIGRATION_PLAN.md § 2. School.schoolId is the primary key
// field name itself (not a generic `id`), since every other table's FK to
// School is named schoolId — see docs/domain/DATABASE_SCHEMA.md § 3.
// SchoolStatus's exact values aren't specified in docs/domain/DOMAIN_MODEL.md
// or docs/domain/DATABASE_SCHEMA.md (only AcademicYearStatus's ACTIVE|CLOSED
// is spelled out there) — ACTIVE/INACTIVE chosen here as the minimal
// two-state default consistent with this system's current single-tenant
// scope; INACTIVE has no application behavior yet.

enum SchoolStatus {
  ACTIVE
  INACTIVE

  @@map("school_status")
}

enum AcademicYearStatus {
  ACTIVE
  CLOSED

  @@map("academic_year_status")
}

model School {
  schoolId         String       @id @default(cuid()) @map("school_id")
  name             String
  shortName        String?      @map("short_name")
  affiliationBoard String?      @map("affiliation_board")
  udiseCode        String?      @unique @map("udise_code")
  status           SchoolStatus @default(ACTIVE)
  // Sprint C1 (Migration 009) — additive School Identity fields the new
  // /admin/configuration module manages. These make School the single,
  // database-backed source of truth for Admin-facing surfaces (Setup
  // Wizard, Configuration Module, Admin Home, Audit Log) — src/config/
  // school.ts/contact.ts remain the separate, static source the public
  // website reads at render time (no live database-driven public-site
  // rendering exists yet, and building that is out of this sprint's own
  // scope). The two are not currently kept in sync automatically — see
  // docs/DECISIONS.md's Sprint C1 entry for why this is named as an
  // honest, not-yet-closed gap rather than silently papered over.
  tagline          String?      @map("tagline")
  medium           String?      @map("medium")
  principalName    String?      @map("principal_name")
  principalTitle   String?      @map("principal_title")
  email            String?      @map("email")
  phone            String?      @map("phone")
  address          String?      @map("address")
  schoolTimings    String?      @map("school_timings")
  officeTimings    String?      @map("office_timings")
  logoUrl          String?      @map("logo_url")
  faviconUrl       String?      @map("favicon_url")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYears      AcademicYear[]
  users              User[]
  schoolClasses      SchoolClass[]
  students           Student[]
  guardians          Guardian[]
  enrollments        Enrollment[]
  subjects           Subject[]
  teachers           Teacher[]
  attendanceSessions AttendanceSession[]
  importBatches      ImportBatch[]
  examTerms          ExamTerm[]
  examinations       Examination[]
  gradeScales        GradeScale[]
  marksRecords       MarksRecord[]
  marksSubmissions   MarksSubmission[]
  promotionRecords   PromotionRecord[]
  reportCards        ReportCard[]

  @@map("schools")
}

model AcademicYear {
  id              String             @id @default(cuid())
  schoolId        String             @map("school_id")
  school          School             @relation(fields: [schoolId], references: [schoolId])
  label           String
  startDate       DateTime           @map("start_date") @db.Timestamptz(3)
  endDate         DateTime           @map("end_date") @db.Timestamptz(3)
  isCurrent       Boolean            @default(false) @map("is_current")
  // Exactly one true per school — schema-enforced via a partial unique index
  // (WHERE is_current = true), hand-added in this migration's SQL, not
  // expressible in schema.prisma syntax. See
  // docs/database/CONSTRAINT_STRATEGY.md § 3.
  status          AcademicYearStatus @default(ACTIVE)
  promotionPolicy Json               @map("promotion_policy")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  sections           Section[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  examTerms          ExamTerm[]
  examinations       Examination[]

  @@unique([schoolId, label])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

// --- Migration 002: Identity Foundation -------------------------------------
// Sprint 1. Physically the second migration built after 001 — numbered 002
// since Migration 002 (Academic Structure — Class/Section/Subject) in
// docs/database/MIGRATION_PLAN.md § 2 hasn't been built yet. Valid ordering:
// that table's own "Depends on" column lists Identity as depending only on
// 001, not on Academic Structure. See MIGRATION_PLAN.md's Sprint 1 status
// note for the full reconciliation — this is a build-order note, not a
// redesign of the conceptual plan.
//
// Scope is narrower than MIGRATION_PLAN.md's original "Migration 003 —
// Identity" slot: `Teacher`/`TeacherQualification` are explicitly out of
// this sprint ("no business modules") and remain for a later migration.
// `Role`, `Account`, `Session`, `VerificationToken` are new — the Auth.js
// adapter's own required shape, which the conceptual domain model never
// modeled (auth infrastructure, not a business entity). See
// docs/DECISIONS.md's Sprint 1 entry.
//
// `Account`/`Session` follow Auth.js v5's (@auth/prisma-adapter) canonical
// Prisma schema exactly — including keeping `Account`'s OAuth-response
// fields (access_token, refresh_token, expires_at, token_type, id_token,
// session_state) as literal snake_case field names, not this project's
// usual camelCase-field-with-@map convention. The adapter constructs its
// Prisma calls using these exact literal keys; renaming them would silently
// break OAuth token storage. This is a deliberate, narrow exception to
// DEVELOPMENT_CONVENTIONS.md § 1, not an oversight.

enum AccessLevel {
  ADMIN
  TEACHER

  @@map("access_level")
}

// A lookup/reference table, not a many-to-many join — every User has
// exactly one Role in V1 (D-001: Guest/Admin/Teacher only). `name` is the
// human-facing job title ("Administrator", "Principal", "Teacher");
// `accessLevel` is the actual permission tier PERMISSION_MATRIX.md's rules
// check against. Two different `name` rows can share one `accessLevel` —
// PROJECT_CONTEXT.md § 4 already describes "Admin" as covering "Principal /
// Management / School Office" job titles, so seeding "Administrator" and
// "Principal" as two Role rows, both ADMIN-tier, matches that framing
// exactly rather than introducing a fourth real permission tier.
model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  accessLevel AccessLevel @map("access_level")
  description String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("roles")
}

// Auth.js adapter User, extended with this app's own fields (schoolId,
// roleId, passwordHash, deactivatedAt) — one User table serves both
// purposes, per ARCHITECTURE.md § 9's Auth.js provider question ("wire in
// whichever provider is chosen") remaining unresolved by design: this
// schema supports either a Credentials or an email/magic-link provider
// without redesign. `roleId` is required, not nullable — this app has no
// public self-registration (D-001; Admin provisions every account), so
// every real User row is created through an Admin-driven flow that assigns
// a role at creation time, never through the adapter's own auto-create path.
model User {
  id                 String    @id @default(cuid())
  schoolId           String    @map("school_id")
  school             School    @relation(fields: [schoolId], references: [schoolId])
  roleId             String    @map("role_id")
  role               Role      @relation(fields: [roleId], references: [id])
  name               String?
  email              String    @unique
  emailVerified      DateTime? @map("email_verified") @db.Timestamptz(3)
  image              String?
  passwordHash       String?   @map("password_hash")
  // Set whenever Admin sets a password on this user's behalf (initial
  // provisioning or an Admin-initiated reset) — the user does not yet know
  // whether the temp password they were given out-of-band is the one that
  // will remain theirs. Cleared only when the user themselves successfully
  // sets their own new password via /change-password, proving they received
  // it — see docs/product/ADMINISTRATION_STRATEGY.md § 2.3 and D-036.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts Account[]
  sessions Session[]
  teacher  Teacher?

  @@index([schoolId])
  @@index([roleId])
  @@map("users")
}

// Auth.js adapter Account — OAuth provider link. Field names/shapes are the
// adapter's own contract, see the migration-header comment above.
model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Auth.js adapter Session — database session strategy.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Auth.js adapter VerificationToken — email/magic-link + email-verification
// flows. No single `id` field, per the adapter's own canonical schema — the
// composite (identifier, token) unique constraint is this model's key.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Migration 003: Academic Foundation -------------------------------------
// Sprint 2. Physically the third migration, and — unlike Sprint 1's Migration
// 002 — its content now genuinely matches docs/database/MIGRATION_PLAN.md's
// original "Migration 002 — Academic structure" row (Class/Section/Subject),
// just built one physical slot later since Identity took "002". `ClassSubject`
// (the many-to-many linking subjects to classes) is deliberately NOT built
// here — out of this sprint's explicit scope; subjects and classes remain
// unlinked until a future migration. See MIGRATION_PLAN.md's Sprint 2 status
// note and docs/DECISIONS.md's Sprint 2 entry.
//
// Named `SchoolClass`, not `Class` — this task's own explicit naming
// instruction, and a real technical reason independent of that instruction:
// `class` is a reserved word in JavaScript/TypeScript, and Prisma-generated
// client code and query-builder chains read awkwardly (and in some contexts
// are outright invalid identifiers) for a model literally named `Class`.
// Every field/relation name follows suit (`schoolClassId`, not `classId`).
//
// All three models carry `deletedAt` (soft-deletable) and a uniqueness rule
// scoped `WHERE deleted_at IS NULL` — a partial unique index, hand-added in
// this migration's SQL, not expressible in schema.prisma syntax (same
// pattern as Migration 001's AcademicYear.isCurrent). The plain @@index
// below supports that hand-added constraint; it is not the constraint
// itself. Per docs/database/SOFT_DELETE_STRATEGY.md § 2 and
// docs/database/INDEXING_STRATEGY.md § 1 (`Class: @@unique([schoolId,
// name])`, `Section: @@unique([classId, academicYearId, name])`, `Subject:
// @@unique([schoolId, name])`) — applied here even though
// docs/domain/DATABASE_SCHEMA.md § 3's illustrative `Class` block doesn't
// show the constraint inline; INDEXING_STRATEGY.md's consolidated table is
// the authoritative reference per its own stated purpose.

model SchoolClass {
  id           String      @id @default(cuid())
  schoolId     String      @map("school_id")
  school       School      @relation(fields: [schoolId], references: [schoolId])
  name         String
  sortOrder    Int         @map("sort_order")
  // Sprint E12 — the GradeScale-assignment gap Sprint E10 identified and
  // named ("no schema path connects GradeScale to any Examination"),
  // closed with the minimal additive relation the documentation itself
  // already specifies: BUSINESS_RULES.md § 5's own "a school may run
  // multiple GradeScales simultaneously... selected per class, not
  // globally fixed" and DOMAIN_MODEL.md § 8.5's own "derives a grade from
  // GradeScale if one is configured for the school/class" both name
  // SchoolClass, not Examination/ExamTerm/AcademicYear, as the correct
  // assignment dimension. Nullable — a marks-only class legitimately has
  // no GradeScale, per GradeScaleType.MARKS_BASED's own precedent (D-053).
  gradeScaleId String?     @map("grade_scale_id")
  gradeScale   GradeScale? @relation(fields: [gradeScaleId], references: [id])
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  sections     Section[]
  examinations Examination[]

  @@index([schoolId, name])
  @@map("school_classes")
}

model Section {
  id             String       @id @default(cuid())
  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  schoolClassId  String       @map("school_class_id")
  schoolClass    SchoolClass  @relation(fields: [schoolClassId], references: [id])
  name           String
  capacity       Int?
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendanceSessions AttendanceSession[]
  marksSubmissions   MarksSubmission[]

  @@index([schoolClassId, academicYearId, name])
  @@map("sections")
}

model Subject {
  id        String    @id @default(cuid())
  schoolId  String    @map("school_id")
  school    School    @relation(fields: [schoolId], references: [schoolId])
  name      String
  code      String?
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  teacherAssignments   TeacherAssignment[]
  examSubjectSchedules ExamSubjectSchedule[]

  @@index([schoolId, name])
  @@map("subjects")
}

// --- Migration 004: Student Foundation --------------------------------------
// Sprint 3. Student, Guardian, StudentGuardian, Enrollment — see
// docs/database/MIGRATION_PLAN.md's Sprint 3 status note and
// docs/DECISIONS.md's Sprint 3 entry.
//
// `Student.admissionNumber` is `@@unique([schoolId, admissionNumber])`, not
// globally unique — docs/domain/DATABASE_SCHEMA.md § 4's illustrative block
// shows it as a bare `@unique`, but docs/database/DATABASE_REVIEW.md § 2
// explicitly flags this as wrong ("two schools will independently issue
// STU-001"), the same class of gap D-025/D-026 already fixed for
// TransferCertificate.tcNumber. `udisePen` stays genuinely globally unique
// (a real national identifier, correctly cross-school).
//
// Per docs/database/DATABASE_REVIEW.md § 2, `Student` has NO `deletedAt` —
// `status` is the only lifecycle signal; a second delete mechanism would
// create two competing "is this student gone" answers.
//
// `Enrollment.id` uses a time-ordered ID (UUIDv7), per
// docs/database/DATABASE_REVIEW.md § 8/§ 11 — it's the FK target every
// future high-volume child table (AttendanceRecord, MarksRecord) will
// reference, so insertion-ordered IDs here improve those tables' own index
// locality, consistent with this project's existing ULID/UUIDv7 adoption
// for AuditLog. `Enrollment` itself has no delete mechanism of any kind —
// it IS the append-only history record.
//
// `StudentGuardian.relationshipType` promoted to a native enum per
// docs/database/ENUM_STRATEGY.md § 2 (already listed there as a
// recommended-enum field, "fixed small enum, not school-configurable").

enum StudentStatus {
  ACTIVE
  ALUMNI
  TRANSFERRED_OUT
  WITHDRAWN

  @@map("student_status")
}

enum RelationshipType {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  OTHER

  @@map("relationship_type")
}

model Student {
  id              String        @id @default(cuid())
  schoolId        String        @map("school_id")
  school          School        @relation(fields: [schoolId], references: [schoolId])
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  dateOfBirth     DateTime      @map("date_of_birth") @db.Timestamptz(3)
  gender          String?
  photoUrl        String?       @map("photo_url")
  udisePen        String?       @unique @map("udise_pen")
  admissionNumber String        @map("admission_number")
  category        String?
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  studentGuardians StudentGuardian[]
  enrollments      Enrollment[]
  promotionRecords PromotionRecord[]
  reportCards      ReportCard[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@map("students")
}

model Guardian {
  id        String    @id @default(cuid())
  schoolId  String    @map("school_id")
  school    School    @relation(fields: [schoolId], references: [schoolId])
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  phone     String
  email     String?
  address   String?
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  studentGuardians StudentGuardian[]

  // No uniqueness on phone, deliberately — docs/database/DATABASE_REVIEW.md
  // § 3: two different guardian records can legitimately share a phone
  // number. Indexed anyway — "a parent calls, staff looks them up by
  // phone" is this table's single most important query pattern.
  @@index([phone])
  @@map("guardians")
}

// Join table. `(studentId, guardianId)` uniqueness is scoped
// WHERE deleted_at IS NULL — a hand-added partial unique index, same
// pattern as Migration 003's soft-deletable tables, per
// docs/database/SOFT_DELETE_STRATEGY.md § 2. The plain @@index below
// supports that hand-added constraint; it is not the constraint itself.
model StudentGuardian {
  id                    String           @id @default(cuid())
  studentId             String           @map("student_id")
  student               Student          @relation(fields: [studentId], references: [id])
  guardianId            String           @map("guardian_id")
  guardian              Guardian         @relation(fields: [guardianId], references: [id])
  relationshipType      RelationshipType @map("relationship_type")
  isPrimaryContact      Boolean          @default(false) @map("is_primary_contact")
  isAuthorizedForPickup Boolean          @default(false) @map("is_authorized_for_pickup")
  deletedAt             DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([studentId, guardianId])
  // "All children of this guardian" per docs/database/DATABASE_REVIEW.md
  // § 3 — the unique's leading column is studentId, so this needs its own
  // index rather than relying on the composite above.
  @@index([guardianId])
  @@map("student_guardians")
}

// The aggregate root for all academic history — see
// docs/database/DATABASE_REVIEW.md § 1's "Identity vs. Fact" principle and
// § 8. No delete mechanism of any kind, not even deletedAt: a promotion or
// withdrawal creates a new Enrollment or sets status elsewhere
// (PromotionRecord, Sprint E11) — it never removes one.
model Enrollment {
  id             String       @id @default(uuid(7))
  schoolId       String       @map("school_id")
  school         School       @relation(fields: [schoolId], references: [schoolId])
  studentId      String       @map("student_id")
  student        Student      @relation(fields: [studentId], references: [id])
  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  sectionId      String       @map("section_id")
  section        Section      @relation(fields: [sectionId], references: [id])
  rollNumber     String       @map("roll_number")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  attendanceRecords AttendanceRecord[]
  marksRecords      MarksRecord[]
  // Sprint E11 — a source Enrollment is "concluded" by at most one
  // PromotionRecord (its own @@unique below); a resulting Enrollment is
  // "created by" at most one PromotionRecord. Two distinct relations on
  // the same pair of models, per Prisma's own disambiguation requirement.
  promotedFrom      PromotionRecord?   @relation("PromotionSourceEnrollment")
  promotedTo        PromotionRecord?   @relation("PromotionResultingEnrollment")
  reportCards       ReportCard[]

  @@unique([studentId, academicYearId])
  @@unique([sectionId, rollNumber])
  @@map("enrollments")
}

// --- Migration 005: Teacher Foundation --------------------------------------
// Sprint 4. Teacher, TeacherQualification, TeacherAssignment — see
// docs/database/MIGRATION_PLAN.md's Sprint 4 status note and
// docs/DECISIONS.md's Sprint 4 entry.
//
// `Teacher` has no `deletedAt`, matching `Student`'s precedent — DOMAIN_MODEL.md
// § 4.5 states the same "status is the only lifecycle signal" invariant
// (ACTIVE | ON_LEAVE | EXITED) that docs/database/DATABASE_REVIEW.md § 2
// explicitly established for Student; Teacher itself isn't one of that
// document's 11 reviewed entities, so this applies that already-established
// principle to new but analogous territory, not a fresh judgment call.
//
// `TeacherQualification.qualificationType` stays a plain String, NOT the
// lookup table docs/database/ENUM_STRATEGY.md § 5 recommends
// (`QualificationType: id, code, label, satisfiesRteMinimum`) — building
// that table now would mean inventing a new entity beyond this sprint's
// explicit "Do NOT invent entities" scope. Flagged as a real, documented,
// deliberately-deferred future improvement, not silently dropped.
//
// `TeacherAssignment` needs two separate constraints, not one — per
// docs/database/DATABASE_REVIEW.md § 7: `@@unique([academicYearId,
// sectionId, subjectId])` (Prisma-native, covers subject-assignment rows)
// does NOT enforce "exactly one class teacher per section per year", since
// Postgres treats multiple NULL `subjectId` values as distinct, not
// colliding. That rule needs its own hand-added partial unique index
// (`WHERE is_class_teacher = true`), same pattern as every other partial
// unique index in this schema.

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  EXITED

  @@map("teacher_status")
}

model Teacher {
  id          String        @id @default(cuid())
  schoolId    String        @map("school_id")
  school      School        @relation(fields: [schoolId], references: [schoolId])
  userId      String        @unique @map("user_id")
  user        User          @relation(fields: [userId], references: [id])
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  phone       String
  gender      String?
  dateOfBirth DateTime?     @map("date_of_birth") @db.Timestamptz(3)
  photoUrl    String?       @map("photo_url")
  status      TeacherStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  qualifications       TeacherQualification[]
  assignments          TeacherAssignment[]
  examSubjectSchedules ExamSubjectSchedule[]

  @@map("teachers")
}

model TeacherQualification {
  id                    String    @id @default(cuid())
  teacherId             String    @map("teacher_id")
  teacher               Teacher   @relation(fields: [teacherId], references: [id])
  qualificationType     String    @map("qualification_type")
  institution           String?
  yearCompleted         Int?      @map("year_completed")
  certificateDocumentId String?   @map("certificate_document_id")
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([teacherId])
  @@map("teacher_qualifications")
}

model TeacherAssignment {
  id             String       @id @default(cuid())
  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  teacherId      String       @map("teacher_id")
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  sectionId      String       @map("section_id")
  section        Section      @relation(fields: [sectionId], references: [id])
  subjectId      String?      @map("subject_id")
  subject        Subject?     @relation(fields: [subjectId], references: [id])
  isClassTeacher Boolean      @default(false) @map("is_class_teacher")
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([academicYearId, sectionId, subjectId])
  @@index([teacherId, academicYearId])
  // The permission-check query ("is this teacher allowed to touch this
  // section"), run on every attendance/marks mutation once those exist —
  // docs/database/DATABASE_REVIEW.md § 7 names this "one of the
  // hottest-path lookups in the whole schema despite the table itself
  // being small."
  @@index([sectionId, academicYearId])
  @@map("teacher_assignments")
}

// --- Migration 006: Attendance ----------------------------------------------
// Sprint 5. AttendanceSession, AttendanceRecord — see
// docs/database/MIGRATION_PLAN.md's Sprint 5 status note and
// docs/DECISIONS.md's Sprint 5 entry.
//
// AttendanceRecord uses a time-ordered ID (UUIDv7), per
// docs/database/DATABASE_REVIEW.md § 9/§ 11 and MIGRATION_PLAN.md's own "006
// — Attendance" row ("apply the ULID/UUIDv7 primary key decision here, not
// retrofitted later") — the first genuinely high-volume table in the schema
// (600K-6.6M rows/school over 15 years). AttendanceSession stays cuid2 —
// trivial volume, one row per section per day.
//
// AttendanceSession carries its own schoolId directly, even though it's
// transitively scoped via Section -> SchoolClass -> School, matching
// Enrollment's own precedent (Migration 004) — docs/database/DATABASE_REVIEW.md
// § 9 names "(schoolId, date), for Admin's cross-section oversight view ('all
// sessions today, across every section')" as a needed composite index, which
// requires the direct column rather than a join through Section on every
// oversight-view query.
//
// markedByUserId/lastEditedByUserId are plain String columns, not Prisma
// relations to User — matching docs/domain/DATABASE_SCHEMA.md § 7's own
// illustrative shape and the same "who did this" pattern already used
// elsewhere in this schema without a formal relation (AuditLog.actorUserId,
// MarksRecord.enteredByUserId/lastEditedByUserId, TransferCertificate.issuedByUserId,
// DocumentRecord.uploadedByUserId) — avoids adding two more back-relation
// arrays to User for an audit-style reference.
//
// Neither table has a deletedAt or status field — per
// docs/database/SOFT_DELETE_STRATEGY.md § 1's third category ("historical
// fact/measurement — no delete mechanism at all"): a day's attendance,
// once taken, isn't deleted; corrections are audited edits
// (lastEditedByUserId/lastEditedAt on AttendanceSession), never row removal.
// AttendanceStatus is a native Postgres enum per docs/database/ENUM_STRATEGY.md
// § 2 — fixed, universal, not school-configurable
// (docs/domain/DOMAIN_MODEL.md § 7.2).

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE

  @@map("attendance_status")
}

model AttendanceSession {
  id                 String    @id @default(cuid())
  schoolId           String    @map("school_id")
  school             School    @relation(fields: [schoolId], references: [schoolId])
  sectionId          String    @map("section_id")
  section            Section   @relation(fields: [sectionId], references: [id])
  date               DateTime  @db.Date
  markedByUserId     String    @map("marked_by_user_id")
  lastEditedByUserId String?   @map("last_edited_by_user_id")
  lastEditedAt       DateTime? @map("last_edited_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  records AttendanceRecord[]

  @@unique([sectionId, date])
  @@index([schoolId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id           String            @id @default(uuid(7))
  sessionId    String            @map("session_id")
  session      AttendanceSession @relation(fields: [sessionId], references: [id])
  enrollmentId String            @map("enrollment_id")
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id])
  status       AttendanceStatus
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  // "This student's attendance history for the year" — the existing unique
  // constraint below leads with sessionId, so this needs its own index, per
  // docs/database/DATABASE_REVIEW.md § 9.
  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@map("attendance_records")
}

// --- Migration 007: Examination Foundation ----------------------------------
// Sprint E7. ExamTerm, Examination, ExamSubjectSchedule, GradeScale — see
// docs/DECISIONS.md's Sprint E7 entry and the Sprint E6 Examination
// Architecture Certification it builds from. This is Foundation only —
// MarksRecord, ReportCard, PromotionRecord, TransferCertificate remain
// unbuilt (Sprint E8+), per Sprint E7's own explicit "Do NOT build Marks
// Entry" scope.
//
// Every core relationship here matches the certified design exactly:
// ExamTerm belongs to AcademicYear; Examination belongs to ExamTerm +
// SchoolClass + AcademicYear; ExamSubjectSchedule belongs to Examination +
// Subject, unique per (examinationId, subjectId) — see
// docs/database/DATABASE_REVIEW.md § 10. GradeScale belongs to School,
// referenced by nothing yet (MarksRecord, its future consumer, doesn't
// exist this sprint).
//
// `schoolId` is carried directly on ExamTerm/Examination (not left purely
// transitive via AcademicYear/SchoolClass), matching Enrollment's and
// AttendanceSession's own precedent — cheap now, avoids a join for the
// common "list all exam terms/examinations for this school" query.
// Examination also carries `academicYearId` directly even though it's
// derivable via examTermId -> ExamTerm.academicYearId — the same
// deliberate denormalization TeacherAssignment.academicYearId already
// uses relative to section.academicYearId, for the same hot-lookup reason
// (docs/database/DATABASE_REVIEW.md § 7).
//
// Examination gains a `status` lifecycle (DRAFT -> SCHEDULED -> ACTIVE ->
// COMPLETED -> ARCHIVED) and `startDate`/`endDate`/`description` — real,
// additive elaboration beyond the certified illustrative schema's bare
// `examTermId, classId, name, deletedAt` shape (DATABASE_SCHEMA.md § 8),
// not a redesign of the certified relationships. `@@index([examTermId,
// schoolClassId])` matches DATABASE_REVIEW.md § 10's own composite-index
// recommendation exactly — deliberately NOT a unique constraint (that
// recommendation names an index, not a uniqueness rule), since a school
// legitimately re-running an examination for one class is a real,
// unblocked scenario.
//
// ExamSubjectSchedule.teacherId is nullable and informational, not
// authoritative — mirrors AttendanceSession.markedByUserId's own
// precedent (a "who is responsible" fact recorded on the row, separate
// from the authorization check). It intentionally does NOT become the
// marks-entry authority: a SchoolClass can have multiple Sections with
// different subject teachers via different TeacherAssignment rows, so a
// single teacherId here can't represent "the" authorized teacher across
// every section. TeacherAssignment(teacherId, sectionId, subjectId,
// academicYearId) remains the sole authority Sprint E8's marks-entry
// authorization will check directly — this field is never consulted for
// that decision, only for display (e.g., "Ms. Sharma — Science").
//
// GradeScale.type (MARKS_BASED | GRADE_BASED | HYBRID) is a deliberate,
// additive elaboration beyond the certified illustrative schema, which
// only described GradeScale as "optionally referenced... a school may run
// marks-only with no grade scale" (DOMAIN_MODEL.md § 8.4) — implying
// "marks-only" is the *absence* of any GradeScale row. Making MARKS_BASED
// an explicit, nameable GradeScale type instead lets a Principal see "Class
// 3-8: Percentage Only" as a real School Settings entry, not silent
// absence a future Admin might mistake for a configuration gap. `bands`
// stays required-shaped JSON but is a valid empty array when
// type = MARKS_BASED — no separate nullable-bands branch needed.
//
// No unique/scoped-index gaps carried forward here — Section/Subject's own
// once-illustrative-only unique constraints (DATABASE_REVIEW.md § 15) were
// already hand-added via raw SQL in their own migration; this migration
// follows the same discipline: every constraint below that Prisma's
// declarative syntax can express is declared inline; none needed raw SQL
// this time (no partial-unique-index requirement in this model group).

// Sprint E9 adds PUBLISHED (COMPLETED -> PUBLISHED -> ARCHIVED) — the same
// single state machine extended by one value, not a second competing one.
// "Publish Results" (this value) is deliberately distinct from Sprint E7's
// own publishExamination() (DRAFT/SCHEDULED -> ACTIVE, "make the exam
// live for teachers") — a genuine terminology collision worth naming: the
// two "publish" verbs mean different things at different lifecycle
// points, so this sprint's own transition function is named
// publishExaminationResults(), never reusing E7's own publishExamination()
// name or logic. See docs/DECISIONS.md's Sprint E9 entry.
enum ExaminationStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  PUBLISHED
  ARCHIVED

  @@map("examination_status")
}

enum ExamSubjectScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@map("exam_subject_schedule_status")
}

enum GradeScaleType {
  MARKS_BASED
  GRADE_BASED
  HYBRID

  @@map("grade_scale_type")
}

model ExamTerm {
  id               String       @id @default(cuid())
  schoolId         String       @map("school_id")
  school           School       @relation(fields: [schoolId], references: [schoolId])
  academicYearId   String       @map("academic_year_id")
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id])
  // "Unit Test 1" | "Half-Yearly" | "Annual" | "FA1" | ... — deliberately a
  // free string, never an enum: term structure genuinely varies school to
  // school and year to year, per DOMAIN_MODEL.md § 8.1.
  name             String
  sortOrder        Int          @map("sort_order")
  weightagePercent Int?         @map("weightage_percent")
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  examinations Examination[]

  @@unique([academicYearId, name])
  @@index([schoolId, academicYearId])
  @@map("exam_terms")
}

model Examination {
  id                String            @id @default(cuid())
  schoolId          String            @map("school_id")
  school            School            @relation(fields: [schoolId], references: [schoolId])
  examTermId        String            @map("exam_term_id")
  examTerm          ExamTerm          @relation(fields: [examTermId], references: [id])
  academicYearId    String            @map("academic_year_id")
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id])
  schoolClassId     String            @map("school_class_id")
  schoolClass       SchoolClass       @relation(fields: [schoolClassId], references: [id])
  name              String
  description       String?
  status            ExaminationStatus @default(DRAFT)
  startDate         DateTime?         @map("start_date") @db.Timestamptz(3)
  endDate           DateTime?         @map("end_date") @db.Timestamptz(3)
  // Sprint E9 — set together, once, by publishExaminationResults(); never
  // touched by any other transition. Mirrors TransferCertificate's own
  // issuedByUserId/dateOfIssue precedent (a terminal action's actor+time
  // recorded directly on the row, not left to AuditLog alone) — Q6/Q15's
  // own "unambiguous, queryable, authoritative" requirement.
  publishedByUserId String?           @map("published_by_user_id")
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  subjectSchedules ExamSubjectSchedule[]
  marksSubmissions MarksSubmission[]
  reportCards      ReportCard[]

  // Composite index, not a unique constraint — see the migration-header
  // comment above and DATABASE_REVIEW.md § 10.
  @@index([examTermId, schoolClassId])
  @@index([schoolId, academicYearId])
  @@map("examinations")
}

model ExamSubjectSchedule {
  id              String                    @id @default(cuid())
  examinationId   String                    @map("examination_id")
  examination     Examination               @relation(fields: [examinationId], references: [id])
  subjectId       String                    @map("subject_id")
  subject         Subject                   @relation(fields: [subjectId], references: [id])
  // Informational only — see the migration-header comment above.
  // TeacherAssignment remains the sole marks-entry authority.
  teacherId       String?                   @map("teacher_id")
  teacher         Teacher?                  @relation(fields: [teacherId], references: [id])
  examDate        DateTime?                 @map("exam_date") @db.Timestamptz(3)
  maxMarks        Int                       @map("max_marks")
  passMarks       Int                       @map("pass_marks")
  durationMinutes Int?                      @map("duration_minutes")
  room            String?
  instructions    String?
  status          ExamSubjectScheduleStatus @default(SCHEDULED)
  deletedAt       DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  marksRecords     MarksRecord[]
  marksSubmissions MarksSubmission[]

  @@unique([examinationId, subjectId])
  @@map("exam_subject_schedules")
}

model GradeScale {
  id        String         @id @default(cuid())
  schoolId  String         @map("school_id")
  school    School         @relation(fields: [schoolId], references: [schoolId])
  name      String
  type      GradeScaleType @default(GRADE_BASED)
  // [{ minPercent: 91, maxPercent: 100, grade: "A1", gradePoint: 10 }, ...]
  // — a valid empty array when type = MARKS_BASED. Non-overlapping bands
  // is a service-layer validation rule (BUSINESS_RULES.md § 5), not a
  // constraint the JSON shape itself enforces.
  bands     Json
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Sprint E12 — the classes this scale is assigned to (see
  // SchoolClass.gradeScale's own comment for the full reasoning).
  schoolClasses SchoolClass[]

  @@unique([schoolId, name])
  @@map("grade_scales")
}

// --- Migration 007b: Marks Entry ---------------------------------------------
// Sprint E8. MarksRecord only — the other half of MIGRATION_PLAN.md's own
// reserved "008 — Marks & report cards" slot (`ReportCard`) remains
// unbuilt, per this sprint's own explicit "Do NOT build Report Cards"
// scope. See docs/DECISIONS.md's Sprint E8 entry.
//
// References Enrollment, not Student — the identical reasoning
// AttendanceRecord already established (docs/database/DATABASE_REVIEW.md
// § 14): a detained student's two years of marks in the same class must
// stay structurally separated by which year's Enrollment they belong to,
// not reconstructed from date ranges.
//
// `id` uses a time-ordered UUIDv7, matching AttendanceRecord's own
// precedent for the first genuinely high-volume table in each migration
// group (docs/database/DATABASE_REVIEW.md § 10/§ 11). `schoolId` is
// carried directly, matching Enrollment's/AttendanceSession's own
// precedent. The extra `@@index([examSubjectScheduleId])` matches
// DATABASE_REVIEW.md § 10's own named requirement — the existing unique
// constraint leads with enrollmentId, so "all marks for this exam+subject
// across a class" needs its own index.
//
// `status` (DRAFT | SUBMITTED) is a deliberate, additive elaboration
// beyond the certified illustrative schema (DATABASE_SCHEMA.md § 8 has no
// status field on MarksRecord) — necessary because this sprint's own
// "Save Draft" vs. "Submit Marks" requirement needs a real state, not a
// derived one. This is a genuine, considered departure from
// AttendanceRecord's own precedent (no per-record status; "locked" is
// derived entirely from record existence) — Marks Entry's own "Submit" is
// a deliberate, explicit teacher action with immutability afterward, not
// merely "every row got a value," so a derived-only state cannot express
// it. See docs/DECISIONS.md's Sprint E8 entry for the full reasoning.
//
// `grade` is modeled (matching DATABASE_SCHEMA.md § 8's own illustrative
// shape) but never populated by any service this sprint — deriving it
// from GradeScale is a Report Card concern, explicitly out of this
// sprint's scope; the column exists so a future Report Card sprint
// doesn't need a schema change to start writing to it.

enum MarksRecordStatus {
  DRAFT
  SUBMITTED

  @@map("marks_record_status")
}

model MarksRecord {
  id                    String              @id @default(uuid(7))
  schoolId              String              @map("school_id")
  school                School              @relation(fields: [schoolId], references: [schoolId])
  enrollmentId          String              @map("enrollment_id")
  enrollment            Enrollment          @relation(fields: [enrollmentId], references: [id])
  examSubjectScheduleId String              @map("exam_subject_schedule_id")
  examSubjectSchedule   ExamSubjectSchedule @relation(fields: [examSubjectScheduleId], references: [id])
  marksObtained         Decimal
  // Derived, re-derivable, not authoritative over marksObtained — see the
  // migration-header comment above. Always null this sprint.
  grade                 String?
  status                MarksRecordStatus   @default(DRAFT)
  enteredByUserId       String              @map("entered_by_user_id")
  lastEditedByUserId    String?             @map("last_edited_by_user_id")
  lastEditedAt          DateTime?           @map("last_edited_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([enrollmentId, examSubjectScheduleId])
  @@index([examSubjectScheduleId])
  @@index([schoolId])
  @@map("marks_records")
}

// --- Migration 007c: Result Review & Publication -----------------------------
// Sprint E9. MarksSubmission — see docs/DECISIONS.md's Sprint E9 entry.
//
// Sprint E8 represented "submission" purely as per-row MarksRecord.status
// (DRAFT/SUBMITTED) plus a derived "every enrolled student SUBMITTED"
// check, with no first-class row for the submission event itself — an
// AuditLog entry was the only trace of "who submitted, when." That was
// sufficient for Sprint E8's own scope (submission was the terminal
// action), but Sprint E9's own required facts — reviewStatus, reviewedBy,
// reviewedAt, returnReason, resubmissionCount — have no existing home:
// they are facts about the WHOLE (ExamSubjectSchedule, Section) batch, not
// about any individual student's mark, so duplicating them onto every
// MarksRecord row would be wasteful and semantically wrong (N copies of
// one fact). MarksSubmission is the minimal, justified new aggregate this
// creates — one row per (examSubjectScheduleId, sectionId), the exact
// granularity Sprint E8's own submitMarks()/submitMarksGrid() already
// treat as one atomic unit of work (see marksEntryWorkspace.service.ts's
// own "one section at a time" comment) — not per-student (too fine, would
// make Principal Review absurdly granular) and not per-ExamSubjectSchedule
// alone (too coarse — a class-wide schedule spans multiple sections, each
// submitted and reviewed independently).
//
// `examinationId` is denormalized directly from
// examSubjectSchedule.examinationId — the same deliberate hot-lookup
// pattern TeacherAssignment.academicYearId/Examination.academicYearId
// already established (docs/database/DATABASE_REVIEW.md § 7) — the
// Principal Dashboard's own completeness/blocking-issues computation
// (Q18's own scale requirement) queries MarksSubmission grouped by
// examinationId+status directly, never scanning MarksRecord, so this
// column is load-bearing for that query shape, not just convenience.
//
// No PUBLISHED value on MarksSubmissionStatus — publication is an
// Examination-level fact (Q7/Q10), recorded once on Examination itself
// (`status`/`publishedByUserId`/`publishedAt` above), never duplicated
// here — "one authoritative source for every lifecycle fact" (this
// sprint's own explicit Q4 instruction).

enum MarksSubmissionStatus {
  SUBMITTED
  RETURNED
  APPROVED

  @@map("marks_submission_status")
}

model MarksSubmission {
  id                    String                @id @default(cuid())
  schoolId              String                @map("school_id")
  school                School                @relation(fields: [schoolId], references: [schoolId])
  examinationId         String                @map("examination_id")
  examination           Examination           @relation(fields: [examinationId], references: [id])
  examSubjectScheduleId String                @map("exam_subject_schedule_id")
  examSubjectSchedule   ExamSubjectSchedule   @relation(fields: [examSubjectScheduleId], references: [id])
  sectionId             String                @map("section_id")
  section               Section               @relation(fields: [sectionId], references: [id])
  status                MarksSubmissionStatus @default(SUBMITTED)
  submittedByUserId     String                @map("submitted_by_user_id")
  submittedAt           DateTime              @map("submitted_at") @db.Timestamptz(3)
  reviewedByUserId      String?               @map("reviewed_by_user_id")
  reviewedAt            DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  returnReason          String?               @map("return_reason")
  // Incremented each time a RETURNED submission is resubmitted — "how many
  // times has this gone back and forth," Q6's own named requirement. Zero
  // on first submission, never decremented.
  resubmissionCount     Int                   @default(0) @map("resubmission_count")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([examSubjectScheduleId, sectionId])
  @@index([examinationId, status])
  @@map("marks_submissions")
}

// --- Migration 011: Promotion -------------------------------------------------
// Sprint E11. PromotionRecord — see docs/DECISIONS.md's Sprint E11 entry.
// Fulfills MIGRATION_PLAN.md's conceptual "010 — Year-end progression" slot
// in part: PromotionRecord only — TransferCertificate remains unbuilt, the
// same partial-fulfillment shape Migration 007b left for MarksRecord vs.
// ReportCard (D-054).
//
// The shape below matches docs/domain/DATABASE_SCHEMA.md's own
// already-published illustrative PromotionRecord model almost exactly —
// that document is explicitly "documentation, not code... the starting
// reference, not a copy-paste source" (its own § 0 disclaimer), so
// deviating where a real implementation genuinely needs to (adding
// schoolId/studentId/createdAt/updatedAt, per that same document's own
// "every model carries schoolId"/"every model has createdAt/updatedAt"
// conventions, omitted from its illustrative blocks for brevity) is
// exactly the "real implementation task decision" it says to expect, not
// a departure from the design. `outcome` keeps all four illustrative
// values (PROMOTED/DETAINED/TRANSFERRED_OUT/WITHDRAWN) — cheap to include
// now, per the same schoolId-convention reasoning, even though this
// sprint's own service/UI only ever writes PROMOTED/DETAINED (see
// docs/DECISIONS.md's own Sprint E11 Q18 answer for why
// TRANSFERRED_OUT/WITHDRAWN are reserved, not wired, this sprint).
//
// Deliberately NO systemRecommendedOutcome/overrideReason columns — the
// system's own recommendation (always "Manual Review Required" this
// sprint, since AcademicYear.promotionPolicy is never `configured: true`
// on any real school today) is never persisted at all, computed fresh on
// every read and shown in the UI only. This is what makes "the
// recommendation must never silently become the official decision"
// (this sprint's own Q5 requirement) trivially, structurally true: there
// is no column for it to leak into. `basis` is always a human-supplied
// classification (NoDetentionPolicy/ExamResult/ReExam, the exact three
// values BUSINESS_RULES.md § 6 names), not system-derived, this sprint.
//
// `resultingEnrollmentId` is nullable in the illustrative shape (a
// TRANSFERRED_OUT/WITHDRAWN outcome has no "next enrollment"); every
// outcome this sprint's own service actually writes (PROMOTED/DETAINED)
// always sets it — enforced in the service layer, not the schema, since
// the schema-level constraint can't express "required for two enum
// values, forbidden for the other two."
//
// No PromotionRecord lifecycle/status field — a considered omission, not
// an oversight. docs/database/TRANSACTION_BOUNDARIES.md § 2's own
// "Promotion decision" row describes exactly one transaction —
// PromotionRecord (create) + Enrollment (create) + AuditLog x2 — as the
// entire unit of work. There is no persisted "draft recommendation" or
// "reviewed, not yet finalized" row: a PromotionRecord does not exist
// until the moment a human decision is finalized, at which point it is
// created complete and permanent, mirroring TransferCertificate's own
// "no soft delete, permanent record" precedent (DOMAIN_MODEL.md § 6.3/
// § 6.4) exactly. The "workflow state" Phase 4 of this sprint's own task
// asked about (recommendation -> decision -> override -> finalization)
// lives entirely in the Promotion Workspace's own request/response cycle
// (nothing held open in the database between a Principal viewing a
// recommendation and clicking Finalize) — not in a mutable database row.

enum PromotionOutcome {
  PROMOTED
  DETAINED
  TRANSFERRED_OUT
  WITHDRAWN

  @@map("promotion_outcome")
}

enum PromotionBasis {
  NO_DETENTION_POLICY
  EXAM_RESULT
  RE_EXAM

  @@map("promotion_basis")
}

model PromotionRecord {
  id                    String           @id @default(cuid())
  schoolId              String           @map("school_id")
  school                School           @relation(fields: [schoolId], references: [schoolId])
  studentId             String           @map("student_id")
  student               Student          @relation(fields: [studentId], references: [id])
  sourceEnrollmentId    String           @unique @map("source_enrollment_id")
  sourceEnrollment      Enrollment       @relation("PromotionSourceEnrollment", fields: [sourceEnrollmentId], references: [id])
  resultingEnrollmentId String?          @unique @map("resulting_enrollment_id")
  resultingEnrollment   Enrollment?      @relation("PromotionResultingEnrollment", fields: [resultingEnrollmentId], references: [id])
  outcome               PromotionOutcome
  basis                 PromotionBasis
  decidedByUserId       String           @map("decided_by_user_id")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([schoolId, outcome])
  @@map("promotion_records")
}

// --- Migration 012: Report Card -----------------------------------------------
// Sprint E12. ReportCard — see docs/DECISIONS.md's Sprint E12 entry.
//
// Built almost exactly to docs/domain/DOMAIN_MODEL.md § 8.6's own
// already-published design: "A generated, stored snapshot... Modeled as a
// real entity (not purely computed on-the-fly) because a report card,
// once generated and shared with a family, should not silently change if
// a mark is corrected afterward — a new version should be a new, dated
// record." docs/domain/REPORTING_MODEL.md § 3's own "Student Report Card"
// entry independently confirms the field name: "Directly reads the
// stored ReportCard.snapshot, not a live re-aggregation."
//
// Scoped to (Enrollment, Examination) — the per-examination grain, the
// smaller of the two grains that same DOMAIN_MODEL.md passage names ("one
// Examination or one full AcademicYear") — a consolidated annual card is
// named, not built, this sprint (Q3's own explicit "choose the smallest
// useful scope" permission).
//
// `snapshot` is a JSON blob, not a set of child rows — deliberately
// mirrors FrameworkConfig's own "write-once snapshot of what was true
// when X happened" precedent (Sprint B3) rather than inventing a
// ReportCardSubjectSnapshot child table; the snapshot's own shape is
// identical to ReportCardDataDTO (src/services/reportCard/reportCard.dto.ts),
// the same shape a not-yet-generated card composes live, so rendering
// code never needs to know which state it's reading.
//
// `@@unique([enrollmentId, examinationId])` — generation is idempotent
// ("get or create," not "decide," unlike PromotionRecord's own
// reject-on-duplicate semantics): requesting a card twice is the same
// artifact being requested again, not a second decision being recorded.
// No regeneration/versioning workflow exists yet — DOMAIN_MODEL.md's own
// "regeneration events should be tracked (superseding a prior snapshot)"
// remains named, not built, this sprint (Q20).

model ReportCard {
  id                String      @id @default(cuid())
  schoolId          String      @map("school_id")
  school            School      @relation(fields: [schoolId], references: [schoolId])
  studentId         String      @map("student_id")
  student           Student     @relation(fields: [studentId], references: [id])
  enrollmentId      String      @map("enrollment_id")
  enrollment        Enrollment  @relation(fields: [enrollmentId], references: [id])
  examinationId     String      @map("examination_id")
  examination       Examination @relation(fields: [examinationId], references: [id])
  // The frozen snapshot — ReportCardDataDTO's own shape, computed once at
  // generation time. Never re-read live after this row exists.
  snapshot          Json
  generatedByUserId String      @map("generated_by_user_id")
  generatedAt       DateTime    @default(now()) @map("generated_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([enrollmentId, examinationId])
  @@map("report_cards")
}

// --- Migration 008: Framework Configuration ---------------------------------
// Sprint B3 — First-Time Setup Wizard & System Readiness. A singleton
// bookkeeping record — exactly one row per deployment, never per-school
// (matches this platform's one-repository-per-school model, D-034) —
// recording what was true *at the moment setup was completed*, not live
// system state. Live state (is the database reachable right now, do the
// required rows currently exist) is answered by checkSystemReadiness()
// (src/services/system/) on every call, computed fresh from the actual
// tables each time — never cached here, since a cached "is everything OK"
// flag would silently go stale the moment something changed after setup.
// setupCompletedBy is a plain string (an actorUserId), not a hard FK to
// User — same reasoning as AuditLog.actorUserId (Migration 000's own
// comment): a deleted/deactivated actor must not corrupt this record's
// history. See docs/DECISIONS.md's Sprint B3 entry (D-039).
model FrameworkConfig {
  id               String    @id @default(cuid())
  frameworkVersion String    @map("framework_version")
  databaseVersion  String?   @map("database_version")
  migrationVersion String?   @map("migration_version")
  setupCompleted   Boolean   @default(false) @map("setup_completed")
  setupCompletedAt DateTime? @map("setup_completed_at") @db.Timestamptz(3)
  setupCompletedBy String?   @map("setup_completed_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("framework_config")
}

// --- Migration 010: Import Engine Foundation --------------------------------
// Sprint D1 — Import Engine Architecture & Foundation. Two tables, each
// independently justified (docs/database/ README's own "every table must
// justify its existence" discipline, applied here):
//
// ImportBatch — the one row per import run, the provenance record
// IMPORT_ENGINE_STRATEGY.md § 2.6 requires to answer "show me everything
// that came from the March 2027 migration" — a question AuditLog alone
// can't answer efficiently, since it isn't grouped by import run.
//
// ImportRow — genuinely required, not a convenience table: without
// per-row state, a chunked commit (TRANSACTION_BOUNDARIES.md § 4's own
// "large batch, not a 40-row submission" pattern) has no way to resume
// after an interruption except recomputing from the raw file every time,
// defeating resumability's purpose. Also carries row-level validation
// errors, per IMPORT_ENGINE_STRATEGY.md § 4's "row number, specific
// field, plain-language reason" requirement — deliberately a JSON array
// column on ImportRow, not a third ImportError table: nothing in this
// sprint's scope needs to query errors independently across batches, so a
// separate table would be schema weight with no present justification
// (re-evaluate only if that need becomes real).
//
// Both follow SOFT_DELETE_STRATEGY.md § 1's third category —
// "historical fact/measurement, no delete mechanism at all" — the same
// category as AttendanceSession/AttendanceRecord/AuditLog: an import run,
// once it happened, isn't deleted; it's a permanent record of what was
// attempted and what resulted. ImportRow uses a time-ordered UUIDv7 PK
// (DATABASE_REVIEW.md § 11's precedent for high-insert-volume tables,
// matching AuditLog/AttendanceRecord) since a single large import can
// genuinely produce thousands of rows; ImportBatch uses cuid() (low
// volume — one row per import run, matching AttendanceSession/
// FrameworkConfig's precedent).

// SCHOOL_CLASS/SECTION/SUBJECT (Sprint D1) replaced with one ACADEMIC_STRUCTURE
// value, Sprint D2 — EPIC_ROADMAP.md's own Epic D Implementation Order item 6
// and IMPORT_ENGINE_STRATEGY.md both describe Classes/Sections/Subjects as
// ONE import type (a school's academic-structure spreadsheet is one file,
// not three separate uploads), and D1 shipped with zero real importer using
// the three-way split — confirmed via grep, no code outside D1's own
// scaffolding referenced any of the three values. Safe to replace rather
// than leave as permanent unused clutter, since nothing depended on them.
enum ImportEntityType {
  STUDENT
  TEACHER
  GUARDIAN
  ACADEMIC_STRUCTURE
  ATTENDANCE
  ADMISSION
  RESULT
  FEE
  TRANSPORT

  @@map("import_entity_type")
}

enum ImportFileFormat {
  CSV
  XLSX
  ODS

  @@map("import_file_format")
}

// Covers Upload through Commit's possible terminal states — Audit/History/
// Report (the task's own extended lifecycle beyond IMPORT_ENGINE_STRATEGY.md's
// original five stages) are cross-cutting reads/writes over this status, not
// additional statuses themselves: Audit happens continuously (every
// committed row's AuditLog entry, via the reused lifecycle service, plus
// this table's own lifecycle-transition AuditLog entries); History and
// Report are query views over a batch regardless of its current status.
enum ImportStatus {
  UPLOADED
  DETECTED
  MAPPED
  VALIDATED
  PREVIEWED
  COMMITTING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED

  @@map("import_status")
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  SKIPPED
  COMMITTED
  FAILED

  @@map("import_row_status")
}

model ImportBatch {
  id              String           @id @default(cuid())
  schoolId        String           @map("school_id")
  school          School           @relation(fields: [schoolId], references: [schoolId])
  importType      ImportEntityType @map("import_type")
  status          ImportStatus     @default(UPLOADED)
  sourceFileName  String           @map("source_file_name")
  sourceFileType  ImportFileFormat @map("source_file_type")
  // SHA-256 of the uploaded file's own bytes, computed at Detect — not
  // unique (a school may legitimately re-upload a corrected file, or the
  // exact same file twice on purpose), just indexed so a future Upload UI
  // can warn "this file was already imported on <date>" per this sprint's
  // own Security Review "duplicate imports" requirement.
  sourceFileHash  String?          @map("source_file_hash")
  // Source column name -> target entity field name, e.g.
  // {"Student Name": "firstName", "DOB": "dateOfBirth"}. Saved per batch so
  // a corrected re-upload of the same entity type doesn't require
  // re-mapping (IMPORT_ENGINE_STRATEGY.md § 2.2's "saved mapping" note) —
  // a future importer reads the most recent batch of the same
  // (schoolId, importType) to pre-fill this as a suggestion, not build a
  // separate mapping-template table this sprint doesn't yet need.
  columnMapping   Json?            @map("column_mapping")
  // Parsed-but-not-yet-mapped file contents ({ columns: string[], rows:
  // Record<string, unknown>[] }) — Sprint D3's Upload stage stores the
  // parser's raw output here (status DETECTED) so the Mapping page (a
  // separate page navigation, not the same request) can read it back;
  // cleared to null once Map is confirmed and ingestImportRows() has
  // turned it into real ImportRow records — never holds data for a
  // COMPLETED/FAILED/PARTIALLY_COMPLETED batch. Storing it here, not a new
  // table, follows the same "extend ImportBatch, don't invent a table for
  // transient state" reasoning columnMapping above already established.
  rawFileData     Json?            @map("raw_file_data")
  totalRows       Int?             @map("total_rows")
  successCount    Int              @default(0) @map("success_count")
  errorCount      Int              @default(0) @map("error_count")
  skippedCount    Int              @default(0) @map("skipped_count")
  createdByUserId String           @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)

  rows ImportRow[]

  @@index([schoolId, importType, createdAt])
  @@index([schoolId, sourceFileHash])
  @@map("import_batches")
}

model ImportRow {
  id               String          @id @default(uuid(7))
  importBatchId    String          @map("import_batch_id")
  importBatch      ImportBatch     @relation(fields: [importBatchId], references: [id])
  rowNumber        Int             @map("row_number")
  // The mapped-but-unvalidated row, keyed by target field name (already
  // translated via ImportBatch.columnMapping) — so Validate/Preview/Commit
  // never need to re-open or re-parse the source file.
  rawData          Json            @map("raw_data")
  status           ImportRowStatus @default(PENDING)
  // Array of { field, message } — row-level, plain-language, per
  // IMPORT_ENGINE_STRATEGY.md § 4. Null until Validate has run.
  validationErrors Json?           @map("validation_errors")
  // The Student/Teacher/etc. id this row produced once committed — the
  // traceability link a future "undo this import" correction procedure
  // (IMPORT_ENGINE_STRATEGY.md § 3's named, honest non-universal-rollback
  // boundary) would need, without this sprint building that procedure.
  entityId         String?         @map("entity_id")
  committedAt      DateTime?       @map("committed_at") @db.Timestamptz(3)

  // The resumability query this table exists for: "give me the next chunk
  // of this batch's still-uncommitted valid rows" — see
  // TRANSACTION_BOUNDARIES.md § 4's own "progress-tracking record" pattern.
  @@index([importBatchId, status, rowNumber])
  @@map("import_rows")
}
